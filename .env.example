# AI 버튜버 시온(sion) — 통합 환경변수 설정
# 이 파일을 .env 로 복사한 뒤 실제 값을 입력하세요.
#   cp .env.example .env

# ────────────────────────────────────────────────────────────────
# [ai_chat] Ollama — ollama serve 실행 후 설치된 모델명 지정 (ollama list 로 확인)
# ────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=sion

# ────────────────────────────────────────────────────────────────
# [ai_chat] ChromaDB — RAG 벡터 DB (docker-compose up -d 로 실행)
# Docker Compose 환경: CHROMA_HOST/PORT 설정 불필요 (자동으로 내부 서비스명 사용)
# 로컬 개발 환경: 아래 값으로 Docker ChromaDB에 연결
# ────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8010
# RAG 비활성화: CHAT_DISABLE_RAG=1 (메모리 문제 시 임시 우회)
CHAT_DISABLE_RAG=0

# ────────────────────────────────────────────────────────────────
# [선택] Google Gemini API (하이브리드 LLM)
# https://aistudio.google.com/apikey 에서 발급
# 설정하면 후원/중요 채팅에 Gemini 사용, 일반 채팅은 Ollama 유지
# LLM_PROVIDER: "hybrid" (기본) | "ollama" (Ollama만) | "gemini" (Gemini만)
# ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=hybrid

# ────────────────────────────────────────────────────────────────
# [선택] ElevenLabs 음성 합성 (ai_voice 모듈)
# https://elevenlabs.io/ → Profile → API Key 에서 발급
# ELEVENLABS_VOICE_ID: /voice/design 으로 생성한 시온 음성 ID
# ────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=

# ────────────────────────────────────────────────────────────────
# [선택] 로컬 실행 시 모듈 URL 오버라이드
# Docker Compose 사용 시 자동으로 서비스명으로 설정되므로 불필요
# 로컬 개발 환경에서 개별 모듈 실행 시 사용
# ────────────────────────────────────────────────────────────────
AI_LIVE2D_URL=http://localhost:8001
AI_CHAT_URL=http://localhost:8002
AI_BROADCAST_URL=http://localhost:8003
AI_VOICE_URL=http://localhost:8004
