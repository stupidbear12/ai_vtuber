# AI 버튜버 시온(sion) — 통합 환경변수 설정
# 이 파일을 .env 로 복사한 뒤 실제 값을 입력하세요.
#   cp .env.example .env

# ────────────────────────────────────────────────────────────────
# [ai_chat] Ollama — ollama serve 실행 후 설치된 모델명 지정 (ollama list 로 확인)
# ────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=sion

# ────────────────────────────────────────────────────────────────
# [ai_chat] ChromaDB — RAG 벡터 DB (docker-compose up -d 로 실행)
# Docker Compose 환경: CHROMA_HOST/PORT 설정 불필요 (자동으로 내부 서비스명 사용)
# 로컬 개발 환경: 아래 값으로 Docker ChromaDB에 연결
# ────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8010
# RAG 비활성화: CHAT_DISABLE_RAG=1 (메모리 문제 시 임시 우회)
CHAT_DISABLE_RAG=0

# ────────────────────────────────────────────────────────────────
# [선택] GPT-SoVITS 음성 합성 (ai_voice 모듈)
# GPT-SoVITS API 서버(api_v2.py)를 먼저 별도 실행해야 합니다.
#   cd GPT-SoVITS && python api_v2.py -a 127.0.0.1 -p 9880
# 모델 가중치/레퍼런스 오디오 경로는
# modules/voice/data/gpt_sovits_config.json 에서 관리합니다.
# ────────────────────────────────────────────────────────────────
GPT_SOVITS_API_URL=http://127.0.0.1:9880

# ────────────────────────────────────────────────────────────────
# [선택] 로컬 실행 시 모듈 URL 오버라이드
# Docker Compose 사용 시 자동으로 서비스명으로 설정되므로 불필요
# 로컬 개발 환경에서 개별 모듈 실행 시 사용
# ────────────────────────────────────────────────────────────────
AI_LIVE2D_URL=http://localhost:8001
AI_CHAT_URL=http://localhost:8002
AI_BROADCAST_URL=http://localhost:8003
AI_VOICE_URL=http://localhost:8004
AI_MUSIC_URL=http://localhost:8005

# ────────────────────────────────────────────────────────────────
# [ai_music] YouTube Music BGM 재생 (방송 중)
# FFmpeg 설치 필요 (yt-dlp 오디오 추출)
# ────────────────────────────────────────────────────────────────
YTMUSIC_ENABLED=1
MUSIC_ENABLE_AI_DJ=0
# ytmusicapi 브라우저 인증 헤더 (선택, 플레이리스트·고품질 검색용)
# YTMUSIC_HEADERS_PATH=modules/music/headers_auth.json
# yt-dlp 쿠키 파일 (선택, 지역 제한·연령 제한 우회)
# YTDLP_COOKIES_FILE=cookies.txt
YTMUSIC_USE_MUSIC_URL=1
YTMUSIC_CACHE_DIR=cache/youtube_music
