# Google Gemini API
GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-2.5-flash  # 기본값, 변경 시 주석 해제

# 방송 채팅 연동 (POST /chat/start 기본값으로 사용)
# 유튜브: 라이브 영상 URL의 ?v= 이후 값 (예: dQw4w9WgXcQ)
YOUTUBE_VIDEO_ID=your_youtube_live_video_id
# 치지직: 채널 설정 페이지 URL의 해시 ID (예: e0faad4df42eba4e3d5d7f14a1e08a7e)
CHZZK_CHANNEL_ID=your_chzzk_channel_hash_id
