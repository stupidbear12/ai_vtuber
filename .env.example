# AI 버튜버 에메스(emeth) — 통합 환경변수 설정
# 이 파일을 .env 로 복사한 뒤 실제 값을 입력하세요.
#   cp .env.example .env

# ────────────────────────────────────────────────────────────────
# [필수] Google Gemini API
# https://aistudio.google.com/app/apikey 에서 발급
# ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# 사용할 Gemini 모델 (기본값: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ────────────────────────────────────────────────────────────────
# [선택] ElevenLabs 음성 합성 (ai_voice 모듈, 현재 스텁)
# https://elevenlabs.io/ 에서 발급 예정
# ────────────────────────────────────────────────────────────────
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_VOICE_ID=your_voice_id_here

# ────────────────────────────────────────────────────────────────
# [선택] 로컬 실행 시 모듈 URL 오버라이드
# Docker Compose 사용 시 자동으로 서비스명으로 설정되므로 불필요
# 로컬 개발 환경에서 개별 모듈 실행 시 사용
# ────────────────────────────────────────────────────────────────
AI_LIVE2D_URL=http://localhost:8001
AI_CHAT_URL=http://localhost:8002
AI_BROADCAST_URL=http://localhost:8003
AI_VOICE_URL=http://localhost:8004
