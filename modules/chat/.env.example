# ai_chat 환경 변수 설정 예시
# 이 파일을 복사해 .env 로 저장하세요.
#   cp .env.example .env

# ── Ollama (로컬 무료) ─────────────────────────────────────────
# 사전 준비: https://ollama.com 설치 후
#   ollama list          # 설치된 모델 확인
#   ollama serve         # (Windows 앱 설치 시 보통 자동 실행)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=sion

# ── ChromaDB (로컬 PersistentClient) ──────────────────────────
# 로컬 파일 저장 방식 (Docker 불필요, pip install chromadb)
CHROMA_DATA_DIR=./data/chromadb
# RAG 비활성화: 1 로 설정하면 ChromaDB 없이 동작 (기억 기능 꺼짐)
CHAT_DISABLE_RAG=0

# 서버 호스트/포트 (기본값: 0.0.0.0:8002)
HOST=0.0.0.0
PORT=8002
