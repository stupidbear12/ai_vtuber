# ai_chat 환경 변수 설정 예시
# 이 파일을 복사해 .env 로 저장하세요.
#   cp .env.example .env

# ── Ollama (로컬 무료) ─────────────────────────────────────────
# 사전 준비: https://ollama.com 설치 후
#   ollama list          # 설치된 모델 확인
#   ollama serve         # (Windows 앱 설치 시 보통 자동 실행)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=sion

# ── ChromaDB (Docker) ──────────────────────────────────────────
# docker-compose up -d chromadb 로 ChromaDB 컨테이너 실행 후 사용
# Docker Compose 내부에서는 CHROMA_HOST=chromadb, CHROMA_PORT=8000 (자동 설정됨)
# 로컬 개발 시 아래 값 사용 (컨테이너 외부 포트 8010)
CHROMA_HOST=localhost
CHROMA_PORT=8010
# RAG 비활성화: 1 로 설정하면 ChromaDB 없이 동작 (기억 기능 꺼짐)
CHAT_DISABLE_RAG=0

# 서버 호스트/포트 (기본값: 0.0.0.0:8002)
HOST=0.0.0.0
PORT=8002
