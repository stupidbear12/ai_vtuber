# ai_chat 환경 변수 설정 예시
# 이 파일을 복사해 .env 로 저장하세요.
#   cp .env.example .env

# ── Ollama (로컬 무료) ─────────────────────────────────────────
# 사전 준비: https://ollama.com 설치 후
#   ollama pull llama3.2
#   ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# 서버 호스트/포트 (기본값: 0.0.0.0:8002)
HOST=0.0.0.0
PORT=8002
