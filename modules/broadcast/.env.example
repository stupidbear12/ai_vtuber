# ai_broadcast 환경 변수 설정 예시
# 이 파일을 복사해 .env 로 저장하고 실제 값을 입력하세요.

# ── 치지직 공식 API (필수: OAuth 인증 흐름에 필요) ──────────────────
# https://developers.chzzk.naver.com 에서 앱 등록 후 발급
CHZZK_CLIENT_ID=your_client_id_here
CHZZK_CLIENT_SECRET=your_client_secret_here

# OAuth 콜백 URI (개발자 콘솔의 리다이렉트 URI와 반드시 일치)
CHZZK_REDIRECT_URI=http://localhost:8003/chzzk/auth/callback

# ── 치지직 토큰 (자동 관리됨 — 직접 설정 가능) ─────────────────────
# OAuth 인증 완료 후 chzzk_tokens.json에 자동 저장됨.
# 아래 환경변수로 직접 지정할 수도 있음 (파일 없을 때 폴백).
# CHZZK_ACCESS_TOKEN=
# CHZZK_REFRESH_TOKEN=
# CHZZK_TOKEN_EXPIRES_AT=

# ── ai_chat 서버 URL (시온 응답 생성) ───────────────────────────────
AI_CHAT_URL=http://localhost:8002

# ── ai_live2d 서버 URL (Live2D 표정 변경) ───────────────────────────
AI_LIVE2D_URL=http://localhost:8001

# ── ai_voice 서버 URL (TTS 음성 합성) ───────────────────────────────
AI_VOICE_URL=http://localhost:8004

# TTS 활성화 여부 (true/false)
BROADCAST_VOICE_ENABLED=true

# ── 서버 호스트/포트 (기본값: 0.0.0.0:8003) ─────────────────────────
HOST=0.0.0.0
PORT=8003
