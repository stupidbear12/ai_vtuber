# ai_voice — Chatterbox TTS 모듈 환경 변수 설정
# 이 파일을 복사해 .env 로 저장하세요.
#   cp .env.example .env
#
# Chatterbox TTS는 로컬 GPU에서 동작합니다. API 키가 필요 없습니다.

# ────────────────────────────────────────────────────────────────
# 서버 호스트/포트 (기본값: 0.0.0.0:8004)
# ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8004

# ────────────────────────────────────────────────────────────────
# [선택] 기본 레퍼런스 오디오 이름
# data/reference_audio/ 에 jfla.wav 를 넣으면 아래에 "jfla" 입력
# 비워두면 Chatterbox 기본 음성(클로닝 없음) 사용
# ────────────────────────────────────────────────────────────────
DEFAULT_REFERENCE_NAME=

# ────────────────────────────────────────────────────────────────
# [참고] 레퍼런스 오디오 등록 방법
# 1. modules/voice/data/reference_audio/ 폴더에 WAV 파일 복사
# 2. 파일명(확장자 제외)이 reference_name으로 사용됨
#    예: jfla.wav → reference_name="jfla"
# 3. POST /voice/set-default  {"reference_name": "jfla"}  로 기본값 설정
# ────────────────────────────────────────────────────────────────
