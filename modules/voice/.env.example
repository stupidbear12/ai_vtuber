# ai_voice — GPT-SoVITS TTS 모듈 환경 변수 설정
# 이 파일을 복사해 .env 로 저장하세요.
#   cp .env.example .env
#
# GPT-SoVITS 추론은 별도 프로세스(api_v2.py)에서 수행됩니다.
# 이 모듈은 해당 API 서버를 HTTP로 호출하는 클라이언트입니다.

# ────────────────────────────────────────────────────────────────
# 서버 호스트/포트 (기본값: 0.0.0.0:8004)
# ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8004

# ────────────────────────────────────────────────────────────────
# GPT-SoVITS API 서버 주소 (기본값: http://127.0.0.1:9880)
#
# 먼저 GPT-SoVITS 저장소에서 API 서버를 실행해야 합니다:
#   cd C:\Users\thtgg\workspace2\GPT-SoVITS
#   python api_v2.py -a 127.0.0.1 -p 9880
#
# 모델 가중치/레퍼런스 오디오 경로는
# modules/voice/data/gpt_sovits_config.json 에서 관리합니다.
# ────────────────────────────────────────────────────────────────
GPT_SOVITS_API_URL=http://127.0.0.1:9880
