# ai_voice — ElevenLabs TTS 모듈 환경 변수 설정
# 이 파일을 복사해 .env 로 저장하고 실제 값을 입력하세요.
#   cp .env.example .env

# ────────────────────────────────────────────────────────────────
# [필수] ElevenLabs API 키
# https://elevenlabs.io/ → Profile → API Key 에서 발급
# ────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ────────────────────────────────────────────────────────────────
# [선택] 기본 음성 ID (에메스 캐릭터 음성)
# /voice/list 로 조회하거나 /voice/design 으로 생성 후 설정
# 비워두면 ElevenLabs 기본 음성(Rachel) 사용
# 설정 후에는 /voice/set-default 로도 변경 가능 (재시작 없이)
# ────────────────────────────────────────────────────────────────
ELEVENLABS_VOICE_ID=

# ────────────────────────────────────────────────────────────────
# 서버 호스트/포트 (기본값: 0.0.0.0:8004)
# ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8004
