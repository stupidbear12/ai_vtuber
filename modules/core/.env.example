# ai_vtuber_core 환경 변수 설정 예시
# 이 파일을 복사해 .env 로 저장하고 실제 값을 입력하세요.

# 각 모듈 서버 URL (기본값으로도 동작하지만, 다른 서버에 배포 시 변경)
AI_LIVE2D_URL=http://localhost:8001
AI_CHAT_URL=http://localhost:8002
AI_BROADCAST_URL=http://localhost:8003
AI_VOICE_URL=http://localhost:8004

# 서버 호스트/포트 (기본값: 0.0.0.0:8000)
HOST=0.0.0.0
PORT=8000
